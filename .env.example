# Copia a .env en el servidor y ajusta
MODELO=granite4.1:3b
NUM_CTX=8192
# Tope de tokens por respuesta (DA-09). ~7 tokens/s en el servidor: 160 tokens ≈ 23 s en el peor caso
NUM_PREDICT=160
PUERTO_CORE=8000
# Datos que deben estar en disco local (SQLite)
DATA_LOCAL=./data
# Más adelante (Vitácora): carpeta del NAS montada en el servidor, p. ej. /mnt/nas/mortimer/vault
# VAULT_PATH=
